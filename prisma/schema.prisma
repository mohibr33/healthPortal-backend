// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  firstName        String
  lastName         String
  email            String    @unique
  password         String?
  role             String    @default("user")
  gender           String?
  phone            String?
  isVerified       Boolean   @default(false)
  otp              String?
  otpExpiry        DateTime?
  googleId         String?   @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  articles         Article[]
  tickets          SupportTicket[]
  resolvedTickets  SupportTicket[] @relation("ResolvedTickets")
  medicines        Medicine[]
  healthProfiles   HealthProfile[]
  mealPlans        MealPlan[]
  reviews          Review[]
  medicalChats     MedicalChat[]

  @@index([email])
  @@index([googleId])
}

model Article {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  imageUrl         String?
  category         String
  shortDescription String
  content          String   @db.Text
  sourceLink        String?
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  author           User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([category])
  @@index([createdBy])
}

model SupportTicket {
  id             String       @id @default(uuid())
  userId         String
  subject        String       @db.VarChar(255)
  description    String       @db.Text
  status         TicketStatus @default(open)
  priority       Priority     @default(Medium)
  resolutionNote String?      @db.Text
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolver       User?        @relation("ResolvedTickets", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([userId])
}

model Medicine {
  id                        String   @id @default(uuid())
  productId                 String   @unique
  slug                      String   @unique
  title                     String
  productImage              String?
  brand                     String?
  usedFor                   String?
  childCategory             String?
  
  // Product Details
  howItWorks                String?  @db.Text
  description               String?  @db.Text
  generics                  String?
  indication                String?  @db.Text
  sideEffects               String?  @db.Text
  whenNotToUse              String?  @db.Text
  dosage                    String?  @db.Text
  storage                   String?  @db.Text
  precautions               String?  @db.Text
  warning1                  String?  @db.Text
  warning2                  String?  @db.Text
  warning3                  String?  @db.Text
  pregnancyCategory         String?  @db.Text
  drugInteractions          String?  @db.Text
  requiresPrescription      Boolean  @default(false)
  
  createdBy                 String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  author                    User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  reviews                   Review[]

  @@index([slug])
  @@index([productId])
  @@index([title])
  @@index([usedFor])
  @@index([generics])
  @@index([childCategory])
}

model HealthProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  
  // Personal Info
  age                   Int
  height                Float    // in cm
  weight                Float    // in kg
  targetWeight          Float?   // in kg
  
  // Health Conditions (stored as JSON array)
  medicalConditions     Json?    // ["Diabetes Type 2", "Hypertension", etc.]
  medications           String?  @db.Text
  specialConditions     Json?    // ["Pregnant", "Breastfeeding", etc.]
  
  // Allergies & Restrictions
  allergies             Json?    // ["Dairy", "Nuts", etc.]
  dietaryPreference     String   // "Non-Vegetarian", "Vegetarian", etc.
  dislikedFoods         Json?    // Array of foods to avoid
  
  // Lifestyle
  activityLevel         String   // "Sedentary", "Moderately Active", etc.
  occupation            String?
  sleepHours            Int?
  sleepQuality          String?
  waterIntake           Int?     // glasses per day
  
  // Goals
  primaryGoal           String   // "Weight Loss", "Muscle Building", etc.
  timeline              String?  // "3 months", "6 months", etc.
  mealsPerDay           Int      @default(3)
  regionalPreference    String?  // "Punjabi", "Sindhi", etc.
  fastingRequirements   Boolean  @default(false)
  
  // Practical Constraints
  monthlyBudget         Int?     // in PKR
  cookingSkill          String?  // "Beginner", "Intermediate", "Advanced"
  maxPrepTime           Int?     // minutes
  eatingOutFrequency    String?
  city                  String?
  
  // Current Habits (stored as JSON)
  currentHabits         Json?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model MealPlan {
  id                String         @id @default(uuid())
  userId            String
  duration          String         // "7 days", "30 days"
  status            MealPlanStatus @default(active)
  
  // User Health Profile snapshot
  userProfileData   Json           // Complete user data at generation time
  
  // AI Generated Plan
  mealPlanData      Json           // Complete meal plan JSON from AI
  
  // Metadata
  totalCalories     Int
  estimatedCost     Int            // in PKR
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id            String   @id @default(uuid())
  userId        String
  medicineId    String
  rating        Int      // 1-5 stars
  message       String   @db.Text
  isApproved    Boolean  @default(false)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([userId, medicineId])
  @@index([userId])
  @@index([medicineId])
  @@index([rating])
  @@index([isApproved])
  @@index([isPublished])
  @@index([createdAt])
}

enum MealPlanStatus {
  active
  completed
  archived
}

enum Priority {
  Low
  Medium
  High
}

enum TicketStatus {
  open
  resolved
}

model MedicalChat {
  id          String          @id @default(uuid())
  userId      String
  title       String          // Auto-generated from first message
  status      ChatStatus      @default(active)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ChatMessage {
  id              String            @id @default(uuid())
  chatId          String
  role            MessageRole       // user or assistant
  content         String            @db.Text
  messageType     MessageType       @default(text)
  
  // For voice messages
  audioUrl        String?
  audioDuration   Int?              // in seconds
  transcription   String?           @db.Text
  
  // Metadata
  tokens          Int?              // AI tokens used
  createdAt       DateTime          @default(now())
  
  chat            MedicalChat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  attachments     ChatAttachment[]
  
  @@index([chatId])
  @@index([createdAt])
}

model ChatAttachment {
  id            String       @id @default(uuid())
  messageId     String
  fileName      String
  fileUrl       String
  fileType      String       // mime type
  fileSize      Int          // in bytes
  uploadedAt    DateTime     @default(now())
  
  message       ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  @@index([messageId])
}

enum ChatStatus {
  active
  archived
}

enum MessageRole {
  user
  assistant
}

enum MessageType {
  text
  voice
  file
}
